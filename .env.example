# Django
# Set DJANGO_ENV=production in deployed environments (loads settings/production.py).
# DJANGO_ENV=development
DEBUG=True
# When True, OTP is printed to console and returned in API responses (works even if DEBUG=0).
# EXPOSE_OTP_IN_RESPONSE=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://www.example.com,https://admin.example.com
# CONN_MAX_AGE=60
# LOG_LEVEL=INFO
# LOG_DATABASE_CONFIG=False

# Django admin (/admin/) — optional: on each container start, create or reset this superuser
# (uses manage.py set_admin_password). Leave unset in production or use a strong one-time password.
# DJANGO_SUPERUSER_EMAIL=admin@gmail.com
# DJANGO_SUPERUSER_PASSWORD=changeme-use-strong-password

# Database — MariaDB / MySQL (required)
DATABASE_ENGINE=mysql
DATABASE_NAME=aiswaryamatrimony
DATABASE_USER=matrimony_user
DATABASE_PASSWORD=matrimony_pass
# Use 127.0.0.1 for host runs (manage.py runserver).
# docker-compose.yml overrides these values to use the internal MySQL service.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3308

# Redis (single URL works for all; optional split for production)
REDIS_URL=redis://redis:6379/0
# CACHE_REDIS_URL=redis://redis:6379/1
# CELERY_BROKER_URL=redis://redis:6379/2
# CELERY_RESULT_BACKEND=redis://redis:6379/3
# CHANNEL_REDIS_URL=redis://redis:6379/4
# Bound Redis socket waits (seconds). Fail fast if Redis stalls; do not hang workers.
# REDIS_SOCKET_CONNECT_TIMEOUT=2
# REDIS_SOCKET_TIMEOUT=2
# /health/ before/after logs to stderr (docker logs). Use while diagnosing hangs.
# HEALTH_DEBUG_LOG=True

# JWT (optional RS256 keys; else HS256 + SECRET_KEY). Lifetimes in minutes.
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=180
# JWT_REFRESH_TOKEN_LIFETIME_MINUTES=432000
# JWT_PRIVATE_KEY=path/to/private.pem
# JWT_PUBLIC_KEY=path/to/public.pem
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=False

# OTP rate limit: max 5 requests per 10 minutes per phone/email
# (configured in settings; override via OTP_RATE_LIMIT_* if needed)

# SMS: console | twilio | msg91
SMS_BACKEND=console
# Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# MSG91 WhatsApp (authkey also editable in Admin → MSG Settings; DB overrides env):
# MSG91_AUTH_KEY=
# MSG91_INTEGRATED_NUMBER=918590123876
# MSG91_SENDER_ID=MATRIM
# MSG91_OTP_TEMPLATE_ID=

# Email (OTP fallback / notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@matrimony.example.com

# AWS S3 / MinIO (optional; leave USE_S3=False for local MEDIA)
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://minio.example.com  # MinIO

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay (membership plan purchases, astrology PDFs)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Razorpay Dashboard → Webhooks
# RAZORPAY_WEBHOOK_SECRET=
# ASTROLOGY_JATHAKAM_PRICE_INR=175
# ASTROLOGY_THALAKURI_PRICE_INR=20
