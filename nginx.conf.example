# Production Nginx example when Nginx runs on the VPS host (not in Compose).
# Django uses network_mode: host and listens on 127.0.0.1:8000.
# Do NOT rely on docker-proxy published ports if host→container HTTP hangs
# (TCP connects but Gunicorn never sees the request).

upstream django_backend {
    server 127.0.0.1:8000;
    keepalive 8;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 10M;

    location /health/ {
        proxy_pass http://django_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        access_log off;
    }

    location /static/ {
        alias /opt/aiswaryamatrimonials/Matrimony_Backend/staticfiles/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location /media/ {
        alias /opt/aiswaryamatrimonials/Matrimony_Backend/media/;
        expires 1d;
    }

    location / {
        proxy_pass http://django_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_redirect off;
    }
}
